# From @BotFather
TELEGRAM_BOT_TOKEN=
# Free at https://cloud.reown.com (WalletConnect)
WALLETCONNECT_PROJECT_ID=
# Infrared API key (needed for /v1/build)
INFRARED_API_KEY=

# Your fee on every swap, in basis points (50 = 0.5%, Router cap currently 200), paid on-chain by the Router to PARTNER_RECIPIENT.
PARTNER_FEE_BPS=50
PARTNER_RECIPIENT=0x...
# false = fee taken from the input token (default), true = from the output token
PARTNER_FEE_ON_OUTPUT=false

# Chains users may trade on, each with its own RPC
CHAINS=1,8453,42161
RPC_URL_1=
RPC_URL_8453=
RPC_URL_42161=

DEFAULT_SLIPPAGE_BPS=50
MAX_SLIPPAGE_BPS=300
# Comma-separated Telegram user ids; empty = anyone can use the bot
ALLOWED_USER_IDS=
DATA_DIR=./data
BOT_NAME=Infrared Trading Bot
