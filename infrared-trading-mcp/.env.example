# Read-only tools (chains, tokens, prices, balances, allowances, quote) need nothing below.
# build_transaction needs INFRARED_API_KEY. approve_token / execute_trade need everything.

INFRARED_API_KEY=
# One RPC per chain you want to pre-flight or trade on. Use a FRESH wallet that only this server controls.
RPC_URL_1=
RPC_URL_8453=
RPC_URL_42161=
PRIVATE_KEY=
# Nothing is ever sent unless this is exactly "true". Without it execute_trade / approve_token are dry-runs.
EXECUTE_ENABLED=false
# Refuse any trade whose inputs are worth more than this (USD, priced by Infrared). Default 100.
MAX_NOTIONAL_USD=100
# Refuse quotes requesting more slippage than this. Default 100 (1%).
MAX_SLIPPAGE_BPS=100
